{
  "ConnectionStrings": {
    "LongBeach": ""
  },
  "Authentication": {
    "Google": {
      "Enabled": false,
      "ClientRegistrationEnabled": false,
      "ClientId": "",
      "AllowedEmail": "",
      "ProvisionAllowedEmailsAsOwners": false
    },
    "Jwt": {
      "Issuer": "LongBeach.OS",
      "Audience": "LongBeach.OS.Client",
      "SigningKey": "",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30
    },
    "MobileAllowedOrigins": [],
    "CookieDomain": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "TrustAllForwarders": false
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "DemoMode": {
    "PublicOperationalData": false
  },
  "Authorization": {
    "SeedOnStartup": false
  },
  "Bootstrap": {
    "InitialOwner": {
      "Enabled": false,
      "Name": "",
      "Email": "",
      "Password": ""
    }
  },
  "HealthChecks": {
    "DatabaseEnabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  }
}
