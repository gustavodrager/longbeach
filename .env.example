# Copie para .env apenas no desenvolvimento local. Nunca versionar o .env real.
LONG_BEACH_POSTGRES_DB=longbeach
LONG_BEACH_POSTGRES_USER=longbeach
LONG_BEACH_POSTGRES_PASSWORD=change-me-local-only
LONG_BEACH_POSTGRES_PORT=5432

LONG_BEACH_API_PORT=5100
LONG_BEACH_WEB_PORT=4173
LONG_BEACH_WEB_ORIGIN=http://localhost:4173
LONG_BEACH_PUBLIC_API_URL=http://localhost:5100

# Use uma sequência aleatória própria com pelo menos 32 caracteres.
LONG_BEACH_JWT_SIGNING_KEY=change-me-local-signing-key-at-least-32-characters
LONG_BEACH_JWT_ISSUER=LongBeach.OS
LONG_BEACH_JWT_AUDIENCE=LongBeach.OS.Client
# Em localhost, deixe vazio. Em produção, use longbeach.quebranunca.com.br
# para que a aplicação web consiga ler somente o cookie anti-CSRF.
LONG_BEACH_COOKIE_DOMAIN=

# O administrador inicial é opcional e só é criado em Development.
LONG_BEACH_BOOTSTRAP_ADMIN_NAME=Administrador Long Beach
LONG_BEACH_BOOTSTRAP_ADMIN_EMAIL=
LONG_BEACH_BOOTSTRAP_ADMIN_PASSWORD=
