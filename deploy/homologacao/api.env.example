# HOMOLOGACAO LOCAL. Modelo sem segredos; nao e carregado automaticamente.
# Usar banco local de demonstracao e chave JWT propria; nunca valores de producao.
# localhost deve ser usado tanto na web quanto na API durante o teste Google.
ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_URLS=http://localhost:5320
ConnectionStrings__LongBeach=
Authentication__Jwt__Issuer=LongBeach.OS.Staging
Authentication__Jwt__Audience=LongBeach.OS.Staging.Client
Authentication__Jwt__SigningKey=
Authentication__CookieDomain=
Cors__AllowedOrigins__0=http://localhost:5321
Database__MigrateOnStartup=false
Authorization__SeedOnStartup=false
Bootstrap__InitialOwner__Enabled=false
DemoMode__PublicOperationalData=false
HealthChecks__DatabaseEnabled=true
Authentication__Google__Enabled=false
Authentication__Google__ClientId=
Authentication__Google__ClientRegistrationEnabled=false
Authentication__Google__AllowedEmail=
Authentication__Google__ProvisionAllowedEmailsAsOwners=false
Payments__Billing__Enabled=false
Payments__PagBank__Enabled=false
Payments__PagBank__PixEnabled=false
Payments__PagBank__CardEnabled=false
Payments__PagBank__BaseUrl=https://sandbox.api.pagseguro.com/
Payments__PagBank__Token=
# Callback externo ainda nao configurado. Nao expor a API sem aprovacao.
Payments__PagBank__WebhookUrl=
Payments__PagBank__WebhookPublicKey=
Payments__PagBank__RefreshWebhookKeys=false
Payments__PagBankSubscriptions__Enabled=false
Payments__PagBankSubscriptions__BaseUrl=https://sandbox.api.assinaturas.pagseguro.com/
Payments__PagBankSubscriptions__Token=
Integrations__PagBankEdi__Enabled=false
