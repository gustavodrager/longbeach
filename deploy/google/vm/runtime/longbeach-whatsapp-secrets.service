[Unit]
Description=Prepare optional LongBeach WhatsApp private configuration
Requires=longbeach-secrets.service
After=network-online.target longbeach-secrets.service
Wants=network-online.target
Before=longbeach-runtime.service

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/longbeach/runtime/whatsapp-secrets.py
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/run/longbeach
