[Unit]
Description=LongBeach PostgreSQL, API and HTTPS proxy
Requires=docker.service
Requires=longbeach-whatsapp-secrets.service
PartOf=docker.service
After=network-online.target docker.service
After=longbeach-whatsapp-secrets.service
Wants=network-online.target
RequiresMountsFor=/var/lib/longbeach
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/longbeach/runtime
UMask=0077
# The host prepares ephemeral credentials from Secret Manager before this unit.
# Host permissions/secrets/mounts precede all container starts.
ExecStartPre=/usr/bin/python3 -B /opt/longbeach/runtime/preflight.py --host-only
# Bring up only PostgreSQL so the next read-only gate can inspect the real schema.
ExecStartPre=/usr/bin/python3 -B /opt/longbeach/runtime/runtime-compose.py postgres
# Never start API/Caddy unless the pinned image proves compatibility with that schema.
ExecStartPre=/usr/bin/python3 -B /opt/longbeach/runtime/preflight.py
ExecStart=/usr/bin/python3 -B /opt/longbeach/runtime/runtime-compose.py start
ExecStop=/usr/bin/python3 -B /opt/longbeach/runtime/runtime-compose.py stop
TimeoutStartSec=600
TimeoutStopSec=120
Restart=on-failure
RestartSec=20
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/var/lib/longbeach /run/longbeach

[Install]
WantedBy=multi-user.target
