[Unit]
Description=LongBeach PostgreSQL, API and HTTPS proxy
Requires=docker.service
After=network-online.target docker.service
Wants=network-online.target
RequiresMountsFor=/var/lib/longbeach
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/longbeach/runtime
UMask=0077
# The host prepares ephemeral credentials from Secret Manager before this unit.
ExecStartPre=/usr/bin/python3 -B /opt/longbeach/runtime/preflight.py
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin HOME=/root /usr/bin/docker compose --env-file /etc/longbeach/runtime.env -f /opt/longbeach/runtime/compose.yaml up -d --wait --wait-timeout 240 --no-build --pull never
ExecStop=/usr/bin/env -i PATH=/usr/bin:/bin HOME=/root /usr/bin/docker compose --env-file /etc/longbeach/runtime.env -f /opt/longbeach/runtime/compose.yaml stop -t 90
TimeoutStartSec=300
TimeoutStopSec=120
Restart=on-failure
RestartSec=20
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/var/lib/longbeach /run/longbeach

[Install]
WantedBy=multi-user.target
